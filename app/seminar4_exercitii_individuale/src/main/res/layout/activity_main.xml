<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/btnDeschideAdaugare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/AdaugaMancare" />

    <TextView
        android:id="@+id/tvRezultat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/NicioMancareInca"
        android:textSize="16sp"
        android:textAlignment="center"
        android:layout_marginTop="20dp" />
    <Button
        android:id="@+id/btnDeschideAdaugareAi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/AdaugaMancareAIDesign"
        android:layout_marginTop="12dp" />

</LinearLayout>