<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:fitsSystemWindows="true"
    android:background="#F8F9FA"
    tools:context=".AddMancareAiActivity">

    <!-- Header / Titlu stilizat -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/AdaugaMancareAIdesign"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#2B2B2B"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp" />

    <!-- Container Formular stilizat ca un Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/denumireMancare"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#6C757D"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etDenumireAi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ex_burger_gourmet"
            android:inputType="text"
            android:textSize="16sp"
            android:padding="12dp"
            android:background="#F1F3F5"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/categorie"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#6C757D"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spCategorieAi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:padding="8dp"
            android:background="#F1F3F5"
            android:entries="@array/categorii_mancare"
            android:layout_marginBottom="28dp" />

        <Button
            android:id="@+id/btnSalveazaAi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/salveazaInMeniu"
            android:textSize="16sp"
            android:padding="12dp" />

    </LinearLayout>

</LinearLayout>